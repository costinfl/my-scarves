  "query": "SELECT ?league ?label ?isFootballLeague ?participants WHERE {\n  VALUES ?league { wd:Q219592 wd:Q650236 wd:Q216022 wd:Q23925620 wd:Q217016 wd:Q1261184 wd:Q204752 wd:Q162031 wd:Q9448 wd:Q19510 wd:Q13394 wd:Q217374 wd:Q82595 wd:Q152665 wd:Q15804 wd:Q194052 wd:Q167541 wd:Q610823 wd:Q201671 wd:Q353508 wd:Q44763 wd:Q163046 wd:Q182994 wd:Q754488 wd:Q237753 wd:Q386384 wd:Q14377162 wd:Q14468438 wd:Q324867 wd:Q35615 wd:Q202699 wd:Q669073 wd:Q485568 wd:Q1141692 wd:Q206073 wd:Q1561244 }\n  # Some big items (Bundesliga, Serie A) only carry a language-neutral \"mul\" label, no \"en\" one.\n  OPTIONAL { ?league rdfs:label ?en . FILTER(LANG(?en) = \"en\") }\n  OPTIONAL { ?league rdfs:label ?mul . FILTER(LANG(?mul) = \"mul\") }\n  BIND(COALESCE(?en, ?mul) AS ?label)\n  # Either typed as an association football league, or as a sports league whose sport (P641) is football.\n  BIND(EXISTS { ?league wdt:P31/wdt:P279* wd:Q15991303 } || EXISTS { ?league wdt:P31/wdt:P279* wd:Q623109 ; wdt:P641 wd:Q2736 } AS ?isFootballLeague)\n  OPTIONAL { ?league wdt:P1132 ?participants }\n}",
