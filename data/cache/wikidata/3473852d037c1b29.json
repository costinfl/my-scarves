  "query": "SELECT ?league ?label ?isFootballLeague ?participants WHERE {\n  VALUES ?league { wd:Q210183 wd:Q116909 wd:Q257282 wd:Q541065 wd:Q237181 wd:Q2299810 wd:Q326859 wd:Q246175 wd:Q244464 wd:Q27054 wd:Q391006 wd:Q1361966 wd:Q1361974 wd:Q12837728 wd:Q797414 wd:Q162604 wd:Q209967 wd:Q155965 wd:Q2186582 wd:Q220875 wd:Q384536 wd:Q235114 wd:Q63980269 wd:Q276085 wd:Q732721 wd:Q477309 wd:Q1824581 wd:Q326422 wd:Q1361963 wd:Q235307 wd:Q1813595 wd:Q238113 wd:Q209946 wd:Q275005 wd:Q2548558 wd:Q202243 wd:Q692009 }\n  # Some big items (Bundesliga, Serie A) only carry a language-neutral \"mul\" label, no \"en\" one.\n  OPTIONAL { ?league rdfs:label ?en . FILTER(LANG(?en) = \"en\") }\n  OPTIONAL { ?league rdfs:label ?mul . FILTER(LANG(?mul) = \"mul\") }\n  BIND(COALESCE(?en, ?mul) AS ?label)\n  # Either typed as an association football league, or as a sports league whose sport (P641) is football.\n  BIND(EXISTS { ?league wdt:P31/wdt:P279* wd:Q15991303 } || EXISTS { ?league wdt:P31/wdt:P279* wd:Q623109 ; wdt:P641 wd:Q2736 } AS ?isFootballLeague)\n  OPTIONAL { ?league wdt:P1132 ?participants }\n}",
